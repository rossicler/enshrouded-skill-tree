{
  "name": "enshrouded-skill-planner",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Rossicler Junior"
  },
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "validate-translations": "node scripts/validate-translations.js",
    "generate-version": "node scripts/generate-version.js",
    "prebuild": "npm run validate-translations && npm run generate-version",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false && tsc -p packages/core",
    "test": "vitest run",
    "e2e": "playwright test --project=desktop --project=mobile",
    "e2e:visual": "playwright test --project=visual",
    "import-skills": "node scripts/skill-data.mjs",
    "import-progression": "node scripts/progression-data.mjs"
  },
  "dependencies": {
    "@enshrouded/core": "*",
    "@headlessui/react": "^2.2.10",
    "@reduxjs/toolkit": "^2.2.1",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.3.3",
    "i18next": "^26.4.3",
    "lucide-react": "^0.577.0",
    "mongodb": "^6.3.0",
    "next": "^16.4.0",
    "next-i18next": "^16.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-redux": "^9.1.0",
    "react-toastify": "^11.1.0",
    "react-tooltip": "^5.26.3",
    "react-zoom-pan-pinch": "^4.2.0",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jiti": "^1.21.7",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  }
}
